                "description": "Scoped search query."
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search monitors using scoped query syntax."
        }
      ]
    }
  ],
  "bundled": true
}